<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Video Downloader" Manufacturer="kayapater" Version="1.6.0" UpgradeCode="a1b2c3d4-e5f6-4789-abcd-123456789012">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Video Downloader" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Video Downloader" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="b2c3d4e5-f6a7-4890-bcde-234567890123">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="Video Downloader" Description="Modern and user-friendly video downloader" Target="[INSTALLFOLDER]VideoDownloader.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanupShortcut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\kayapater\VideoDownloader" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Guid="c3d4e5f6-a7b8-4901-cdef-345678901234">
        <File Source="..\VideoDownloader\publish\VideoDownloader.exe" KeyPath="yes" />
      </Component>
      <Component Guid="d4e5f6a7-b8c9-4012-def0-456789012345">
        <File Source="..\VideoDownloader\publish\VideoDownloader.dll" />
      </Component>
      <Component Guid="e5f6a7b8-c9d0-4123-ef01-567890123456">
        <File Source="..\VideoDownloader\publish\Newtonsoft.Json.dll" />
      </Component>
      <Component Guid="f6a7b8c9-d0e1-4234-f012-678901234567">
        <File Source="..\VideoDownloader\publish\Microsoft.Windows.SDK.NET.dll" />
      </Component>
      <Component Guid="a7b8c9d0-e1f2-4345-0123-789012345678">
        <File Source="..\VideoDownloader\publish\WinRT.Runtime.dll" />
      </Component>
      <Component Guid="b8c9d0e1-f2a3-4456-1234-890123456789">
        <File Source="..\VideoDownloader\publish\VideoDownloader.runtimeconfig.json" />
      </Component>
      <Component Guid="c9d0e1f2-a3b4-4567-2345-901234567890">
        <File Source="..\VideoDownloader\publish\VideoDownloader.deps.json" />
      </Component>
      <Component Guid="d0e1f2a3-b4c5-4678-3456-012345678901">
        <File Source="..\VideoDownloader\publish\yt-dlp.exe" />
      </Component>
      <Component Guid="e1f2a3b4-c5d6-4789-4567-123456789012">
        <File Source="..\VideoDownloader\publish\ffmpeg.exe" />
      </Component>
      <Component Guid="f2a3b4c5-d6e7-4890-5678-234567890123">
        <File Source="..\VideoDownloader\publish\ffprobe.exe" />
      </Component>
      <Component Guid="a3b4c5d6-e7f8-4901-6789-345678901234">
        <File Source="..\VideoDownloader\publish\ffplay.exe" />
      </Component>
      <Component Guid="b4c5d6e7-f809-4012-7890-456789012345">
        <File Source="..\VideoDownloader\publish\bundled-dependencies.json" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
